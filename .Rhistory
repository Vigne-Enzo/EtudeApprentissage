library(tidyverse)
data_etudiants <- data_score %>%
filter(etudiant == "true") %>%
group_by(illustration) %>%
summarise(
moyenne_score = mean(score),
se = sd(score) / sqrt(n()),
.groups = "drop"
)
ggplot(data_etudiants, aes(x = illustration, y = moyenne_score, fill = illustration)) +
geom_bar(stat = "identity", width = 0.5, color = "black") +
geom_errorbar(aes(ymin = moyenne_score - se, ymax = moyenne_score + se), width = 0.1) +
scale_fill_manual(values = c("gray70", "skyblue"), labels = c("Texte seul", "Avec Images")) +
labs(
title = "Performance des Étudiants selon le support",
x = "Type de support d'apprentissage",
y = "Score moyen (0 à 1)",
fill = "Condition"
) +
theme_minimal()
