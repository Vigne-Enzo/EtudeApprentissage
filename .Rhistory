data_temps_etud <- data_temps %>%
filter(etudiant == "true") %>%
group_by(illustration) %>%
summarise(
temps_moyen = mean(moy_temps, na.rm = TRUE),
se = sd(moy_temps, na.rm = TRUE) / sqrt(n()),
.groups = "drop"
)
ggplot(data_temps_etud, aes(x = illustration, y = temps_moyen, fill = illustration)) +
geom_bar(stat = "identity", width = 0.5, color = "black") +
geom_errorbar(aes(ymin = temps_moyen - se, ymax = temps_moyen + se), width = 0.1) +
# Utilisation de couleurs froides pour le temps
scale_fill_manual(values = c("#999999", "#33CC66"),
labels = c("Texte seul", "Avec Images")) +
labs(
title = "Temps de réponse moyen des Étudiants",
subtitle = "Basé sur la matrice data_temps",
x = "Support d'apprentissage",
y = "Temps moyen par question (secondes)"
)
